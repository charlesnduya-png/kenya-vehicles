# Gmail account that created the App Password (Google Account → Security → App passwords)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Local API (mail + PayHero)
MAIL_API_PORT=8787
MAIL_FROM_NAME=Kenya Vehicles

# PayHero M-Pesa (from PayHero → API Keys / Payment Channels)
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_ACCOUNT_ID=
PAYHERO_CHANNEL_ID=
PAYHERO_BASIC_AUTH=Basic xxxxx
# Optional public HTTPS URL for PayHero payment callbacks
PAYHERO_CALLBACK_URL=
